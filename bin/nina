#!/usr/bin/env bash
# nina — network discovery and SSH device mapper
#
# Usage:
#   nina                    run the full pipeline (discover, fingerprint,
#                             register-new, bootstrap-keys, push)
#   nina <subcommand>       run a single pipeline step in isolation
#                             (discover, self-register, seed, fingerprint,
#                             register-new, bootstrap-keys, push, all)
#   nina --ports            show all open ports per host
#   nina -h|--help          full usage for all tools in this suite
#
# Environment:
#   NINA_BASE     installation root (default: ~/unix-toolkit-tools/nina)
#
# Exit codes:
#   0  completed successfully
#   1  error (missing dep, lock conflict, no interface)

set -eu

# Derive BASE from this script's own location so install/runtime never
# depend on a hardcoded path. Honors NINA_BASE override if set.
_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
# Resolve symlink chain so invocation via ~/.local/bin/nina finds the
# real bin dir (readlink -f is GNU/Termux; fall back to a manual walk).
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"
. "$_bindir/_bootstrap"
export BASE="$DATA"

# ---------------------------------------------------------------------------
# Help — covers every tool in the suite
# ---------------------------------------------------------------------------
_print_help() {
    if [ -f "$HELPTXT" ]; then
        cat "$HELPTXT"
    else
        printf '[ERROR] readme.txt not found at %s\n' "$HELPTXT" >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# client-setup — emit a script to configure the SSH CLIENT (Mac/Termux) so the
# server's clipso can mirror to the client clipboard via a forwarded socket.
# Robust where OSC52 fails (macOS Terminal.app). Run on this server; pipe the
# output into a shell ON THE CLIENT, or copy-paste it there.
# ---------------------------------------------------------------------------
_do_client_setup() {
    _srv_sock="$HOME/.local/share/nina/clip.sock"
    cat <<'CLIENTEOF'
#!/usr/bin/env bash
# nina client clipboard setup — run ON YOUR Mac or Termux.
# Auto-detects OS: macOS -> LaunchAgent (pbsync); else -> background listener.
# Adds a RemoteForward so the server socket pipes into your local clipboard.
set -eu
SERVER_HOST="${1:-}"
[ -n "$SERVER_HOST" ] || { echo "usage: bash this.sh <ssh-host-or-alias>"; exit 1; }
SSH_CONF="$HOME/.ssh/config"
mkdir -p "$HOME/.local/bin"

if [ "$(uname)" = "Darwin" ]; then
  LOCAL_SOCK="$HOME/.clipd.sock"
  cat > "$HOME/.local/bin/pbsync" <<'PBS'
#!/bin/bash
SOCK="$HOME/.clipd.sock"
rm -f "$SOCK"
exec nc -lU "$SOCK" | pbcopy
PBS
  chmod +x "$HOME/.local/bin/pbsync"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$HOME/Library/LaunchAgents/io.clipd.agent.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.clipd.agent</string>
  <key>ProgramArguments</key>
  <array><string>$HOME/.local/bin/pbsync</string></array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST
  launchctl unload "$HOME/Library/LaunchAgents/io.clipd.agent.plist" 2>/dev/null || true
  launchctl load "$HOME/Library/LaunchAgents/io.clipd.agent.plist"
  echo "macOS: LaunchAgent io.clipd.agent cargado"
else
  LOCAL_SOCK="$HOME/.local/share/nina/clip.sock"
  if command -v termux-clipboard-set >/dev/null 2>&1; then CLIP_CMD=termux-clipboard-set
  elif command -v wl-copy >/dev/null 2>&1; then CLIP_CMD=wl-copy
  elif command -v xclip >/dev/null 2>&1; then CLIP_CMD="xclip -selection clipboard"
  else echo "no clipboard tool found"; exit 1; fi
  cat > "$HOME/.local/bin/nina-clip-listener" <<LISTENER
#!/usr/bin/env bash
SOCK="$LOCAL_SOCK"
rm -f "\$SOCK"
while true; do nc -lU "\$SOCK" 2>/dev/null | $CLIP_CMD || true; done
LISTENER
  chmod +x "$HOME/.local/bin/nina-clip-listener"
  echo "Linux/Termux: inicia el listener: ~/.local/bin/nina-clip-listener &"
fi

touch "$SSH_CONF"; chmod 600 "$SSH_CONF"
BEG="# >>> nina-clip $SERVER_HOST >>>"
END="# <<< nina-clip $SERVER_HOST <<<"
TMP="$(mktemp)"
awk -v b="$BEG" -v e="$END" '$0==b{s=1} s&&$0==e{s=0;next} !s{print}' "$SSH_CONF" > "$TMP"
{
  cat "$TMP"
  echo "$BEG"
  echo "Host $SERVER_HOST"
  echo "    RemoteForward /home/u/.local/share/nina/clip.sock $LOCAL_SOCK"
  echo "$END"
} > "$SSH_CONF"
rm -f "$TMP"
echo "Listo. Reconecta SSH para crear el socket en el servidor."
CLIENTEOF
}
if [ "${1:-}" = client-setup ]; then _do_client_setup; exit 0; fi
_source_mods core/util.sh core/blockdb.sh core/lock.sh core/cache.sh identity/identity.sh identity/registry.sh discovery/iface.sh discovery/scan.sh discovery/fingerprint.sh misc/devices.sh misc/output.sh misc/ssh_bootstrap.sh core/nina-dispatch.sh


# ---------------------------------------------------------------------------
# ssh-setup <alias> — configure Ed25519 key-based SSH auth for a registered
# device. Generates a key if missing, installs it on the remote via
# ssh-copy-id (or a manual ssh+cat fallback), then verifies the connection.
# ---------------------------------------------------------------------------
_do_ssh_setup() {
    _alias="${1:-}"
    [ -n "$_alias" ] || { printf '[ERROR] usage: nina ssh-setup <alias>\n' >&2; exit 1; }

    _db="$BASE/state/devices.db"
    [ -f "$_db" ] || { log ERROR "devices database missing: $_db"; exit 1; }

    _blk="$(blockdb_get "$_db" alias "$_alias")"
    [ -n "$_blk" ] || { log ERROR "unknown device alias: '$_alias'"; exit 1; }

    _ip="$(blockdb_field "$_blk" ip)"
    _user="$(blockdb_field "$_blk" user)"
    _port="$(blockdb_field "$_blk" port)"
    [ -n "$_port" ] || _port=22
    [ -n "$_user" ] || { log ERROR "no user set for '$_alias' — run nssh once to set it"; exit 1; }

    log INFO "ssh-setup: $_alias ($_user@$_ip:$_port)"

    _key="$HOME/.ssh/id_ed25519"
    _pub="${_key}.pub"

    # Verify the existing key is actually functional (exists, correct perms,
    # ssh-keygen can derive its pubkey) before deciding to reuse or regenerate.
    _key_is_functional() {
        [ -f "$_key" ] || return 1
        [ -f "$_pub" ] || return 1
        _perm="$(stat -c %a "$_key" 2>/dev/null || echo "")"
        [ "$_perm" = "600" ] || return 1
        ssh-keygen -y -f "$_key" >/dev/null 2>&1 || return 1
        return 0
    }

    if _key_is_functional; then
        log INFO "using existing key: $_key"
    else
        log WARN "no functional Ed25519 key found — generating $_key"
        rm -f "$_key" "$_pub"
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        require_cmd ssh-keygen
        ssh-keygen -t ed25519 -f "$_key" -N "" -C "nina-$(node_alias 2>/dev/null || hostname)" || {
            log ERROR "ssh-keygen failed"; exit 1
        }
        chmod 600 "$_key"
        chmod 644 "$_pub"
    fi

    if has_cmd ssh-copy-id; then
        log INFO "installing key via ssh-copy-id"
        ssh-copy-id -p "$_port" -i "$_pub" "$_user@$_ip" || {
            log ERROR "ssh-copy-id failed"; exit 1
        }
    else
        log WARN "ssh-copy-id not found — using manual fallback"
        _pubcontent="$(cat "$_pub")"
        ssh -p "$_port" "$_user@$_ip" "
            mkdir -p ~/.ssh && chmod 700 ~/.ssh
            grep -qxF '$_pubcontent' ~/.ssh/authorized_keys 2>/dev/null || printf '%s\n' '$_pubcontent' >> ~/.ssh/authorized_keys
            chmod 600 ~/.ssh/authorized_keys
        " || { log ERROR "manual key install failed"; exit 1; }
    fi

    log INFO "verifying key-based connection"
    if ssh -p "$_port" -o BatchMode=yes -o ConnectTimeout=5 "$_user@$_ip" true 2>/dev/null; then
        log OK "ssh-setup complete for '$_alias' — key auth verified"
    else
        log ERROR "key installed but verification failed — check manually: ssh -p $_port $_user@$_ip"
        exit 1
    fi

    # Offer to purge stale keys from the remote authorized_keys, keeping only
    # the one just verified. Only offered when running interactively.
    if [ -t 0 ]; then
        printf 'Purge other keys from remote authorized_keys, keep only this one? [y/N] '
        read -r _purge_confirm </dev/tty || _purge_confirm=""
        case "$_purge_confirm" in
            [yY]|[yY][eE][sS])
                _pubcontent="$(cat "$_pub")"
                if ssh -p "$_port" -o BatchMode=yes -o ConnectTimeout=5 "$_user@$_ip" "
                    printf '%s\n' '$_pubcontent' > ~/.ssh/authorized_keys
                    chmod 600 ~/.ssh/authorized_keys
                "; then
                    log OK "remote authorized_keys purged — only current key remains"
                else
                    log ERROR "purge failed — remote authorized_keys left unchanged"
                    exit 1
                fi
                ;;
            *)
                log INFO "purge skipped — remote authorized_keys left unchanged"
                ;;
        esac
    fi
}
if [ "${1:-}" = "ssh-setup" ]; then shift; _do_ssh_setup "$@"; exit 0; fi

# ---------------------------------------------------------------------------
# Dispatch to subcommand (nina#502 -- migrated from monolithic pipeline)
# ---------------------------------------------------------------------------
nina_dispatch "$@"
