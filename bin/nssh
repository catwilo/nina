#!/usr/bin/env bash
# nssh — SSH to a device registered in devices.db
#
# Usage:  nssh <alias> [remote-command...]
#
# The alias is resolved against BASE/state/devices.db.
# All remaining arguments are forwarded as the remote command.
# If no user is saved for the alias, prompts interactively and persists it.
#
# NOEMAP_SSH_ROLE is exported so ssh_config Match blocks can distinguish
# interactive sessions (ControlMaster auto) from transfer sessions (no).
#
# Exit codes:
#   0   — SSH session ended normally
#   1   — alias not found, db missing, or arg error
#   N   — exit code forwarded from the ssh process

set -eu

_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"
. "$_bindir/_bootstrap"
_source_mods core/util.sh core/blockdb.sh misc/devices.sh

case "${1:-}" in
    -h|--help)
        printf 'usage: nssh [-t|--pty] [--safe|--raw] <alias> [command...]\n'
        printf '  SSH to a device registered in devices.db; forwards any command.\n'
        printf '  -t, --pty   force pseudo-terminal allocation (for remote sudo, etc.)\n'
        printf '  --safe      force nsafe wrapper (timeout + cleanup)\n'
        printf '  --raw       disable nsafe wrapper even in non-interactive context\n'
        printf '  Sin flags, nssh usa nsafe automaticamente cuando no hay TTY\n'
        printf '  (background, pipe, script), para no colgarse por ControlMaster.\n'
        exit 0
        ;;
esac

# Optional flags before the alias:
#   -t|--pty  force PTY
#   --safe    force nsafe wrapper (timeout + cleanup)
#   --raw     disable nsafe wrapper even in non-interactive context
# Default: usar nsafe si no hay TTY (detectado mas abajo).
_pty=""
_nsafe_override=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--pty) _pty="-tt"; shift ;;
        --safe)   _nsafe_override="force"; shift ;;
        --raw)    _nsafe_override="off"; shift ;;
        *)        break ;;
    esac
done

# Deteccion de contexto: si no hay TTY y no se pidio --raw, usar nsafe.
# Razon: ControlMaster deja un socket SSH abierto cuando nssh corre en
# background, y el padre se cuelga esperando en `wait`. nsafe le pone un
# timeout y limpia huerfanos automaticamente.
_use_nsafe=0
case "$_nsafe_override" in
    force) _use_nsafe=1 ;;
    off)   _use_nsafe=0 ;;
    *)
        if [ ! -t 0 ]; then
            _use_nsafe=1
        fi
        ;;
esac


[ $# -ge 1 ] || {
    printf 'usage: nssh <alias> [command...]\n' >&2
    exit 1
}

_name="$1"
shift

_row="$(resolve_device "$_name" "$BASE/state")"
_ip="$(printf '%s\n'   "$_row" | cut -d'|' -f1)"
_user="$(printf '%s\n' "$_row" | cut -d'|' -f2)"
_port="$(printf '%s\n' "$_row" | cut -d'|' -f3)"

# Prompt for user if missing or placeholder; persists to devices.db
_user="$(_ensure_user "$_name" "$DB" "$_user")"

[ -n "$_user" ] || {
    printf '[ERROR] no user configured for "%s"\n' "$_name" >&2
    exit 1
}

# Signal to ssh_config which Match block to activate. Only default to
# "interactive" when the caller hasn't already set a role (e.g.
# ssh_key_bootstrap/ndevs export "automation" before invoking nssh as an
# internal subroutine -- that value must survive, not be overwritten).
: "${NOEMAP_SSH_ROLE:=interactive}"
export NOEMAP_SSH_ROLE


# Start clipboard tunnel on-demand for interactive sessions; stop on exit
if [ -t 0 ] && command -v nina >/dev/null 2>&1; then
    nina clip tunnel start >/dev/null 2>&1 || true
    trap 'nina clip tunnel stop >/dev/null 2>&1 || true' EXIT INT TERM
fi

_ssh_connect() {
    if [ -f "$CFG" ]; then
        _ssh_args=(ssh -F "$CFG" $_pty -p "$_port" "${_user}@${_ip}")
    else
        log WARN "ssh_config not found at $CFG - connecting without it"
        _ssh_args=(ssh $_pty -p "$_port" "${_user}@${_ip}")
    fi

    if [ "$_use_nsafe" -eq 1 ] && command -v nsafe >/dev/null 2>&1; then
        # Sin TTY, envolver ssh en nsafe: timeout + cleanup de huerfanos.
        # Evita el cuelgue por ControlMaster en contextos background.
        nsafe run -- "${_ssh_args[@]}" "$@"
    else
        "${_ssh_args[@]}" "$@"
    fi
}

# ControlPath from ssh_config is ~/.ssh/noemap-%r@%h:%p
_socket="$HOME/.ssh/noemap-${_user}@${_ip}:${_port}"

_ssh_connect "$@"
_rc=$?

# A stale ControlMaster socket makes ssh fail before auth. If the socket
# exists and the first attempt failed, drop it and retry exactly once.
# A genuine auth failure with no socket present never triggers a retry.
if [ "$_rc" -ne 0 ] && [ -S "$_socket" ]; then
    log INFO "stale control socket detected - clearing and retrying once"
    ssh -O exit -p "$_port" "${_user}@${_ip}" >/dev/null 2>&1 || true
    rm -f "$_socket"
    _ssh_connect "$@"
    _rc=$?
fi

exit $_rc
